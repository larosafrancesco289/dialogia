{
  "name": "dialogia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "build:hosted": "VITE_HOSTED_BUILD=true vite build && VITE_HOSTED_BUILD=true bun run build:worker",
    "start": "vite preview --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache src tests functions",
    "knip": "knip --include files,dependencies,unlisted,unresolved,binaries",
    "knip:exports": "knip --include exports,types,nsExports,nsTypes",
    "lint:types": "tsc --noEmit",
    "check": "bun run lint:types && bun run test && bun run format:check && bun run lint && bun run knip",
    "test": "tsx --test 'tests/**/*.test.ts' 'src/**/*.test.ts'",
    "tutor:simulate": "tsx src/modules/tutor/tooling/simulate.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@heroicons/react": "^2.1.5",
    "@tanstack/react-router": "^1.170.18",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "framer-motion": "^12.23.24",
    "katex": "^0.16.22",
    "lucide-react": "^1.8.0",
    "medium-zoom": "^1.1.0",
    "mermaid": "^10.9.2",
    "pdfjs-dist": "^5.4.530",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.2.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.11.19",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.2.62",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "knip": "^6.29.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "bun@1.3.2"
}
