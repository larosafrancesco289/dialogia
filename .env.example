# Dialogia configuration.
#
# Nothing here is required. Users paste their own provider key into the app and
# it stays in their browser, so a deployment carries no keys at all. Every
# variable below changes a client default and is INLINED INTO THE BUNDLE at
# build time. Never put a secret in one. Copy to .env.local to use.

# Optional: new sessions start with Zero-Data-Retention enforcement.
VITE_OR_ZDR_ONLY_DEFAULT=false

# Optional: default OpenRouter routing preference (balanced|speed|cost).
# `balanced` leaves OpenRouter's own price-weighted routing alone.
VITE_OR_ROUTE_PREFERENCE_DEFAULT=balanced

# Optional: absolute origin, sent to OpenRouter as the HTTP-Referer courtesy
# header when deploying behind a proxy.
VITE_APP_BASE_URL=

# Optional: client log verbosity (debug|info|warn|error|silent).
VITE_LOG_LEVEL=

# The tutor simulation CLI (`bun run tutor:simulate`) reads this from the
# shell or .env.local. The app never does.
# OPENROUTER_API_KEY=sk-or-...
