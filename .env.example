# Server-side keys (never expose client-side)

# Required: server-side OpenRouter key (used by app/api/openrouter/* proxies)
# This key is used for individual and developer tiers
# OPENROUTER_API_KEY=sk-or-...

# Optional: separate OpenRouter key for free tier users
# If not set, falls back to OPENROUTER_API_KEY
# OPENROUTER_FREE_API_KEY=sk-or-...

# Optional: Brave Search API (for deep research)
# BRAVE_SEARCH_API_KEY=...

# Optional: xAI API key (for voice mode - developer tier only)
# XAI_API_KEY=...

# ═══════════════════════════════════════════════════════════════════════════════
# Access Gate Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Generate strong random values for production (32+ hex chars)
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_COOKIE_SECRET=replace-with-strong-random-hex
ACCESS_CODE_PEPPER=replace-with-strong-random-hex

# ─────────────────────────────────────────────────────────────────────────────
# Tiered Access Codes (HMAC-SHA256 hashes)
# ─────────────────────────────────────────────────────────────────────────────
# Generate hash: crypto.createHmac('sha256', ACCESS_CODE_PEPPER).update(code).digest('hex')

# Developer codes - full access including voice mode (not consumed)
# ACCESS_CODES_DEVELOPER_HASHED=abc123...,def456...
ACCESS_CODES_DEVELOPER_HASHED=

# Individual codes - one-time use, full access except voice mode
# ACCESS_CODES_INDIVIDUAL_HASHED=ghi789...,jkl012...
ACCESS_CODES_INDIVIDUAL_HASHED=

# DEPRECATED: Legacy single-tier codes (use tiered codes above instead)
# ACCESS_CODES_HASHED=

# ─────────────────────────────────────────────────────────────────────────────
# Vercel KV (for tracking consumed codes)
# ─────────────────────────────────────────────────────────────────────────────
# These are auto-configured when you add Vercel KV to your project
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════════
# Frontend Toggles (safe to expose)
# ═══════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_USE_OR_PROXY=true

# Optional: default ZDR behavior (false when unset); uncomment to default to ZDR-only
# NEXT_PUBLIC_OR_ZDR_ONLY_DEFAULT=true

# Optional: default route preference for OpenRouter providers (speed|cost)
# NEXT_PUBLIC_OR_ROUTE_PREFERENCE_DEFAULT=cost
