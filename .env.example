# Server-side keys (never expose client-side)

# Required: server-side OpenRouter key (used by functions/api/openrouter/* proxies)
OPENROUTER_API_KEY=sk-or-...

# Optional: separate OpenRouter key for free tier users
# If not set, falls back to OPENROUTER_API_KEY
OPENROUTER_FREE_API_KEY=sk-or-...

# Optional: Anthropic server-side key (used by functions/api/anthropic/* proxies)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Tavily Search API (server-side web search tool)
TAVILY_API_KEY=tvly-...

# Optional: Fal key (image generation)
FAL_KEY=...

# Optional: xAI API key (voice mode - developer tier only)
XAI_API_KEY=...

# Legacy fallbacks (avoid; kept for compatibility)
# OPENROUTER_KEY=sk-or-...
# ANTHROPIC_KEY=sk-ant-...

# ═══════════════════════════════════════════════════════════════════════════════
# Access Gate Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Generate strong random values for production (32+ hex chars)
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_COOKIE_SECRET=replace-with-strong-random-hex
ACCESS_CODE_PEPPER=replace-with-strong-random-hex

# Tiered Access Codes (HMAC-SHA256 hashes)
# Generate: crypto.createHmac('sha256', ACCESS_CODE_PEPPER).update(code).digest('hex')
ACCESS_CODES_DEVELOPER_HASHED=
ACCESS_CODES_INDIVIDUAL_HASHED=

# Optional: set the cookie domain for access sessions
ACCESS_COOKIE_DOMAIN=

# ═══════════════════════════════════════════════════════════════════════════════
# Frontend Toggles (baked into the client bundle at build time)
# ═══════════════════════════════════════════════════════════════════════════════

# Build the hosted variant: ships the access gate route and expects the
# Cloudflare Pages Functions in functions/ to be deployed alongside it.
VITE_HOSTED_BUILD=false

# Route OpenRouter requests through the hosted key proxy
VITE_USE_OR_PROXY=true

# Route Anthropic requests through the hosted key proxy
VITE_USE_ANTHROPIC_PROXY=false

# There is deliberately no client-side key variable. Provider keys are entered
# by the user in Settings > Providers and stored in their browser; a hosted
# deployment supplies its own key through the proxies above instead.

# Optional: let the client use this deployment's server-side Tavily key through
# the gated /api/tavily proxy. BYOK users add their own key in the app instead.
VITE_TAVILY_SEARCH_ENABLED=false

# Optional: default ZDR behavior (false when unset)
VITE_OR_ZDR_ONLY_DEFAULT=false

# Optional: default route preference for OpenRouter providers (balanced|speed|cost)
VITE_OR_ROUTE_PREFERENCE_DEFAULT=balanced

# Optional: absolute origin for share/export URLs
VITE_APP_BASE_URL=

# Optional: logging controls
VITE_LOG_LEVEL=

# Optional: auth debug toggles (server-only)
AUTH_DEBUG_ROUTE_ENABLED=false
AUTH_DEBUG_HEADERS=false
AUTH_TIMING_DEBUG=false
