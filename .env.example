# Dialogia configuration.
#
# The default (BYOK) build needs none of this: users paste their own key into
# the app and it stays in their browser. Everything here is for the hosted
# variant, or for changing defaults. Copy to .env.local and edit.
#
# VITE_* values are INLINED INTO THE CLIENT BUNDLE at build time. Never put a
# secret in one. Everything else is read server-side, per request.

# ─────────────────────────────────────────────────────────────────────────────
# Client build flags
# ─────────────────────────────────────────────────────────────────────────────

# Build the hosted variant: ships the /access route and expects dist/_worker.js
# to be deployed alongside the static assets.
VITE_HOSTED_BUILD=false

# Route model traffic through this deployment's key proxies. A key the user
# pastes into the app always wins over the proxy.
VITE_USE_OR_PROXY=false
VITE_USE_ANTHROPIC_PROXY=false

# Let the client reach this deployment's TAVILY_API_KEY through the gated
# /api/tavily proxy. BYOK users add their own Tavily key in the app instead.
VITE_TAVILY_SEARCH_ENABLED=false

# There is deliberately no client-side provider key variable.

# Optional: new sessions start with Zero-Data-Retention enforcement.
VITE_OR_ZDR_ONLY_DEFAULT=false

# Optional: default OpenRouter routing preference (balanced|speed|cost).
# `balanced` leaves OpenRouter's own price-weighted routing alone.
VITE_OR_ROUTE_PREFERENCE_DEFAULT=balanced

# Optional: absolute origin, when deploying behind a proxy.
VITE_APP_BASE_URL=

# Optional: client log verbosity.
VITE_LOG_LEVEL=

# ─────────────────────────────────────────────────────────────────────────────
# Server keys — hosted variant only, never exposed to the client
# ─────────────────────────────────────────────────────────────────────────────

# Required when VITE_USE_OR_PROXY is true.
OPENROUTER_API_KEY=sk-or-...

# Optional: a separate OpenRouter key for free-tier users. Falls back to the above.
OPENROUTER_FREE_API_KEY=

# Required when VITE_USE_ANTHROPIC_PROXY is true.
ANTHROPIC_API_KEY=sk-ant-...

# Backs the /api/tavily search proxy.
TAVILY_API_KEY=tvly-...

# ─────────────────────────────────────────────────────────────────────────────
# Access gate — hosted variant only
# ─────────────────────────────────────────────────────────────────────────────

# Generate strong random values (32+ hex chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_COOKIE_SECRET=replace-with-strong-random-hex
ACCESS_CODE_PEPPER=replace-with-strong-random-hex

# Comma-separated HMAC-SHA256 hashes of the access codes you hand out:
#   crypto.createHmac('sha256', ACCESS_CODE_PEPPER).update(code).digest('hex')
ACCESS_CODES_DEVELOPER_HASHED=
ACCESS_CODES_INDIVIDUAL_HASHED=

# Optional: cookie domain for access sessions.
ACCESS_COOKIE_DOMAIN=

# The gate bypasses auth only when this is explicitly `development`. An absent
# value is read as production, because Cloudflare does not set it.
# NODE_ENV=development

# Optional auth debugging.
AUTH_DEBUG_ROUTE_ENABLED=false
AUTH_DEBUG_HEADERS=false
AUTH_TIMING_DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting — hosted variant only
# ─────────────────────────────────────────────────────────────────────────────

# Without both of these, an in-memory per-instance limiter is used, which is
# best-effort and not shared across worker instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
